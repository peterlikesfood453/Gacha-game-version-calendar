BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//WorkBuddy//Game Version Calendar//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Star Rail - Version Calendar
X-WR-CALDESC:Only Honkai: Star Rail previews and version updates. Leaving a
  game? On iPhone just delete that calendar. On Android\, switch OFF "show"
  in Calendar account settings instead of tapping Delete - deleting one URL
  subscription removes all of them.
X-WR-TIMEZONE:Asia/Shanghai
REFRESH-INTERVAL;VALUE=DURATION:PT6H
X-PUBLISHED-TTL:PT6H
BEGIN:VEVENT
UID:hsr-47-release@game-version-calendar
DTSTAMP:20261102T120000Z
DTSTART:20261111T030000Z
DTEND:20261111T033000Z
SUMMARY:Honkai: Star Rail 4.7 Version Update
DESCRIPTION:Aha the Aeon enters the banner pool for the first time\, and th
 e warp runs until Dec 22\, 15:00 (UTC+8). Servers open around 11:00.\n\nAl
 l times are Beijing time (UTC+8).\nEntries marked Estimated or TBC are pro
 jected from version cycles and may shift once officially announced.
LOCATION:Honkai: Star Rail
CATEGORIES:Honkai: Star Rail
STATUS:CONFIRMED
TRANSP:TRANSPARENT
BEGIN:VALARM
TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:Version update tomorrow
END:VALARM
BEGIN:VALARM
TRIGGER:-PT2H
ACTION:DISPLAY
DESCRIPTION:Version update - servers opening soon
END:VALARM
END:VEVENT
