TRIGGER:-P1D
ACTION:DISPLAY
DESCRIPTION:Version update tomorrow
END:VALARM
BEGIN:VALARM
TRIGGER:-PT2H
ACTION:DISPLAY
DESCRIPTION:Version update - servers opening soon
END:VALARM
END:VEVENT
